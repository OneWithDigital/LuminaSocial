# ════════════════════════════════════════════════════════════════
#  LuminaSocial Ultra — Environment Variables
#  Copy to .env and fill in your values. Never commit .env.
# ════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina_secret
POSTGRES_DB=luminasocial
# asyncpg scheme used by the API; plain postgresql:// used by workers
DATABASE_URL=postgresql+asyncpg://lumina:lumina_secret@postgres:5432/luminasocial

# ─── API server ──────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=change_me_in_production

# ─── Anthropic — Brand Guardrail & Feedback Loop LLM ────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── OpenAI — Caption generation & embeddings (optional) ────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o

# ─── Trend Ingestion — SerpApi ───────────────────────────────────
# Get your key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
TREND_REGION=US
TREND_FETCH_INTERVAL_MINUTES=60

# ─── Video Factory ───────────────────────────────────────────────
FFMPEG_THREADS=4
STORAGE_BASE_PATH=/storage

# ─── Instagram Graph API ─────────────────────────────────────────
# Long-lived page access token from Meta Developer Console
# https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=
# Numeric Instagram Business Account ID
INSTAGRAM_ACCOUNT_ID=

# ─── TikTok Content Posting API ──────────────────────────────────
# OAuth 2.0 access token from TikTok Developer Portal
# https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── YouTube Data API v3 ─────────────────────────────────────────
# Server API key from Google Cloud Console (restrict to YouTube Data API)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── Next.js Dashboard ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change_me_in_production

# ─── Analytics Worker ────────────────────────────────────────────
ANALYTICS_POLL_INTERVAL_MINUTES=360
VIRAL_THRESHOLD_VIEWS=10000
MID_THRESHOLD_VIEWS=1000

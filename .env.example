# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina_secret
POSTGRES_DB=luminasocial
DATABASE_URL=postgresql://lumina:lumina_secret@postgres:5432/luminasocial

# ─── API ─────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=change_me_in_production

# ─── Anthropic (Brand Guardrail + Feedback Loop LLM) ─────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Trend Ingestion ─────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_key_here
TREND_FETCH_INTERVAL_MINUTES=60
TREND_REGION=US

# ─── Video Factory ───────────────────────────────────────────
FFMPEG_THREADS=4
STORAGE_BASE_PATH=/storage
VARIANT_A_STYLE=fast_aggressive
VARIANT_B_STYLE=cinematic_minimal

# ─── Platform Publishing ─────────────────────────────────────
# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Shorts
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── Next.js Dashboard ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change_me_in_production

# ─── Analytics Worker ────────────────────────────────────────
ANALYTICS_POLL_INTERVAL_MINUTES=360
VIRAL_THRESHOLD_VIEWS=10000
MID_THRESHOLD_VIEWS=1000
